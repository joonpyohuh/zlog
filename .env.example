ANTHROPIC_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=
GEMINI_API_KEY=

# Hybrid AI routing (PROMPT sequence — IDs must stay env-driven, not hardcoded)
ZLOG_ANALYZER_PROVIDER=anthropic
ZLOG_ANALYZER_MODEL=claude-haiku-4-5-20251001
ZLOG_ANALYZER_ESCALATION_MODEL=claude-sonnet-4-5-20250929

ZLOG_DIRECTOR_PROVIDER=anthropic
ZLOG_DIRECTOR_MODEL=claude-sonnet-4-5-20250929

ZLOG_EVALUATOR_PROVIDER=openai
ZLOG_EVALUATOR_MODEL=gpt-5.6-luna

ZLOG_REPAIR_PROVIDER=openai
ZLOG_REPAIR_MODEL=gpt-5.6-sol

ZLOG_QUALITY_MODE=balanced

# Still photo proxy: long-edge max before encode (aspect preserved; no 9:16 pre-crop)
ZLOG_STILL_PROXY_MAX_EDGE=2048
