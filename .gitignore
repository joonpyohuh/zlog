# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/

# intermediate pipeline artifacts (per-run, regenerable — see CLAUDE.md)
work/*
!work/.gitkeep

# raw source footage (large binaries, not for the repo)
footage/*
!footage/.gitkeep

# Remotion / Node (render/ project)
render/node_modules/
render/out/
render/.env
# staged per-render symlinks/copies of footage+bgm, see render/resolve-props.mjs
render/public/

# Web UI
web/node_modules/
web/dist/
next-web/node_modules/
next-web/.next/
next-web/.env
next-web/.env.local
next-web/.env.*.local

# local web job state
.zlog_jobs/

# regenerated trend thumbnails
taste/trend_frames/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json
